# Supabase public client values (do not put secrets in NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep disabled until legal notice is actually approved/published,
# Auth redirect URLs and email provider are configured and tested.
AGENCY_SIGNUP_ENABLED=false
B2B_PRIVACY_NOTICE_URL=

# Server-only placeholders for later milestones; never commit real values.
# SUPABASE_SECRET_KEY=
# DATABASE_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EMAIL_PROVIDER_API_KEY=

# Stripe Sandbox only. Never copy real secret values to Git.
# Enable BOTH flags only after applying the sandbox orders migration to STAGING.
STRIPE_SANDBOX_ENABLED=false
NEXT_PUBLIC_STRIPE_SANDBOX_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=
